<Window x:Class="OpenSteps.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="22,20,22,20">
        <TextBlock x:Name="PromptText" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
        <TextBlock x:Name="HintText" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,0" />
        <TextBox x:Name="ValueBox" AutomationProperties.Name="Value" Margin="0,14,0,0" MaxLength="200" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,7" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="Ok_Click" Padding="22,7"
                    Style="{StaticResource PrimaryActionButton}" />
        </StackPanel>
    </StackPanel>
</Window>
