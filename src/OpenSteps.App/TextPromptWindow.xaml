<Window x:Class="OpenSteps.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="PromptLabel" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" MinHeight="34" VerticalContentAlignment="Center" />
        <TextBlock x:Name="HintLabel" Style="{StaticResource SubtleText}" FontSize="11.5" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,7" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click" Padding="22,7"
                    Style="{StaticResource PrimaryActionButton}" />
        </StackPanel>
    </StackPanel>
</Window>
