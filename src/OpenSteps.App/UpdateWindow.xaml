<Window x:Class="OpenSteps.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSteps update" Width="620" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Heading  -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadlineText" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
            <TextBlock x:Name="SubheadText" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!--  What's changed  -->
        <TextBlock x:Name="ChangesLabel" Grid.Row="1" Text="What's changed" Style="{StaticResource CaptionText}" Margin="0,18,0,8" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="NotesScroller" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
                <StackPanel x:Name="NotesPanel" />
            </ScrollViewer>
        </Border>

        <!--  Progress while the update is being fetched and installed  -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBarControl" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" />
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed"
                Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>

        <!--  Buttons  -->
        <DockPanel Grid.Row="4" Margin="0,18,0,0" LastChildFill="False">
            <CheckBox x:Name="AutoCheckBox" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Content="Check for updates daily" FontSize="12"
                      Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"
                      ToolTip="OpenSteps looks at its releases page once a day and tells you when a new version is out. Nothing is sent about you or your guides." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SkipButton" Content="Skip this version" Click="Skip_Click" Padding="14,7" Margin="0,0,8,0"
                        Style="{StaticResource SubtleActionButton}"
                        ToolTip="Don't mention this version again. A later version will still be offered." />
                <Button x:Name="LaterButton" Content="Later" Click="Later_Click" Padding="18,7" Margin="0,0,8,0" IsCancel="True"
                        ToolTip="Close this and stay on the version you have. OpenSteps will ask again tomorrow." />
                <Button x:Name="UpdateButton" Content="Update now" Click="Update_Click" Padding="22,7" IsDefault="True"
                        Style="{StaticResource PrimaryActionButton}" />
                <Button x:Name="CloseButton" Content="Close" Click="Later_Click" Padding="22,7"
                        Style="{StaticResource PrimaryActionButton}" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
