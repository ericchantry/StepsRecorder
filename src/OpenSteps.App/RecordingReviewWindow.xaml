<Window x:Class="OpenSteps.App.RecordingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording review" Width="1280" Height="780" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!--  ─────────── Video ─────────── -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <ComboBox x:Name="SegmentPicker"
                              DockPanel.Dock="Right"
                              Width="220"
                              DisplayMemberPath="Label"
                              SelectionChanged="SegmentPicker_SelectionChanged"
                              ToolTip="Each time you start recording, OpenSteps saves a separate video." />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RECORDING" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="SessionTitleText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="Player"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened"
                                      MediaEnded="Player_MediaEnded"
                                      MediaFailed="Player_MediaFailed" />
                        <TextBlock x:Name="NoVideoText"
                                   Foreground="#C9D1DC"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="40"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton"
                            Grid.Column="0"
                            Content="&#xE768;"
                            ToolTip="Play / pause (Space)"
                            Click="PlayPause_Click"
                            Style="{StaticResource IconButton}"
                            Width="36" Height="36" />
                    <Button Grid.Column="1"
                            Content="&#xE892;"
                            ToolTip="Back 5 seconds (Left arrow)"
                            Click="Back_Click"
                            Style="{StaticResource IconButton}"
                            Width="36" Height="36"
                            Margin="4,0,0,0" />
                    <Slider x:Name="PositionSlider"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="12,0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="PositionSlider_ValueChanged" />
                    <TextBlock x:Name="TimeText"
                               Grid.Column="3"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,12,0" />
                    <ComboBox x:Name="SpeedPicker"
                              Grid.Column="4"
                              Width="76"
                              SelectedIndex="1"
                              SelectionChanged="SpeedPicker_SelectionChanged"
                              ToolTip="Playback speed">
                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                        <ComboBoxItem Content="1×" Tag="1" />
                        <ComboBoxItem Content="1.5×" Tag="1.5" />
                        <ComboBoxItem Content="2×" Tag="2" />
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!--  ─────────── Timeline ─────────── -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Input timeline"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
                    <RadioButton Content="All" IsChecked="True" GroupName="Filter" Tag="All" Checked="Filter_Checked" Margin="0,0,14,0" />
                    <RadioButton Content="Steps" GroupName="Filter" Tag="Step" Checked="Filter_Checked" Margin="0,0,14,0" />
                    <RadioButton Content="Keyboard" GroupName="Filter" Tag="Keyboard" Checked="Filter_Checked" Margin="0,0,14,0" />
                    <RadioButton Content="Mouse" GroupName="Filter" Tag="Mouse" Checked="Filter_Checked" />
                </StackPanel>

                <ListBox x:Name="TimelineList"
                         Grid.Row="2"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         SelectionChanged="TimelineList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TimeLabel}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LabelText"
                                               Text="{Binding Label}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}"
                                               TextWrapping="Wrap"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding RawKeys, StringFormat=Keys: {0}}"
                                               TextWrapping="Wrap"
                                               FontSize="11.5"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RawKeys}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsStep}" Value="True">
                                    <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="LabelText" Property="Foreground" Value="{StaticResource InfoBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TimelineFooter"
                           Grid.Row="3"
                           Style="{StaticResource SubtleText}"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
