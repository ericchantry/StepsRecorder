<Window x:Class="OpenSteps.App.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSteps recording"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="StopBarButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource RecordingBrush}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A52532" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8,6"
            MouseLeftButtonDown="Bar_MouseLeftButtonDown"
            ToolTip="Drag to move">
        <Border.Effect>
            <DropShadowEffect Color="#1F2937" BlurRadius="22" ShadowDepth="3" Opacity="0.2" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE76F;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       Cursor="SizeAll"
                       Margin="4,0,10,0" />

            <Ellipse x:Name="RecordingDot"
                     Width="9" Height="9"
                     Fill="{StaticResource RecordingBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.35"
                                                 Duration="0:0:0.9"
                                                 AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="PausedIcon"
                       Text="&#xE769;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="11"
                       Foreground="{StaticResource WarningBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Visibility="Collapsed" />

            <TextBlock x:Name="StatusText"
                       Text="Recording"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       MinWidth="62" />
            <TextBlock x:Name="DetailText"
                       FontSize="12.5"
                       FontFamily="Segoe UI"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       MinWidth="118"
                       Margin="6,0,8,0" />

            <Button x:Name="PauseButton"
                    Click="Pause_Click"
                    Style="{StaticResource BarButton}"
                    ToolTip="Pause recording. Nothing is recorded while paused.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PauseButtonIcon"
                               Text="&#xE769;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock x:Name="PauseButtonText" Text="Pause" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="Stop_Click"
                    Style="{StaticResource StopBarButton}"
                    ToolTip="Stop recording and open the guide editor">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="Cancel_Click"
                    Style="{StaticResource BarButton}"
                    ToolTip="Stop and discard everything recorded since you pressed Record">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
