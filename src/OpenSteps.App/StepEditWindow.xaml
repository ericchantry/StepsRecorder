<Window x:Class="OpenSteps.App.StepEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit step" Height="820" Width="1280" MinHeight="600" MinWidth="900"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="58" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, StringFormat='{}{0} colour'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="12" Padding="2">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!--  Tools  -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="SelectToolButton" Content="Select" Tag="Select" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Click an edit to select it, then drag it to move it or drag a corner to resize it. Delete removes it; arrow keys nudge it; double-click a label to change its text." />
                    <Button x:Name="CropToolButton" Content="Crop" Tag="Crop" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag to choose the part of the screenshot to show. The rest is kept and can be brought back." />
                    <Button x:Name="BoxToolButton" Content="Box" Tag="Box" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag to draw a box around something" />
                    <Button x:Name="ArrowToolButton" Content="Arrow" Tag="Arrow" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag from the tail to the point of the arrow" />
                    <Button x:Name="CalloutToolButton" Content="Callout" Tag="Callout" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Click to place a numbered callout. Numbers go up by one each time and close up when one is removed." />
                    <Button x:Name="TextToolButton" Content="Text" Tag="Text" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Click where a label should go, type it, and press Enter" />
                    <Button x:Name="HighlightToolButton" Content="Highlight" Tag="Highlight" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag to shade an area in yellow" />
                    <Button x:Name="BlurToolButton" Content="Blur" Tag="Blur" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag to pixelate private information" />
                    <Button x:Name="CircleToolButton" Content="Circle" Tag="Circle" Click="Tool_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Drag to circle something" />
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Tag="#D92D20" ToolTip="Red" Background="#D92D20" Click="Color_Click" Style="{StaticResource Swatch}" />
                        <Button Tag="#2563EB" ToolTip="Blue" Background="#2563EB" Click="Color_Click" Style="{StaticResource Swatch}" />
                        <Button Tag="#16A34A" ToolTip="Green" Background="#16A34A" Click="Color_Click" Style="{StaticResource Swatch}" />
                        <Button Tag="#F59E0B" ToolTip="Orange" Background="#F59E0B" Click="Color_Click" Style="{StaticResource Swatch}" />
                        <Button Tag="#111827" ToolTip="Black" Background="#111827" Click="Color_Click" Style="{StaticResource Swatch}" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RemoveCropButton" Content="Remove crop" Click="RemoveCrop_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Show the whole screenshot again" />
                    <Button x:Name="ResetButton" Content="Reset to original" Click="Reset_Click" Style="{StaticResource ToolButton}"
                            ToolTip="Remove every edit and the crop. You can undo this." />
                    <Button x:Name="UndoButton" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"
                            Style="{StaticResource IconButton}" Margin="6,0,6,0" />
                    <Button x:Name="RedoButton" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click"
                            Style="{StaticResource IconButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Screenshot  -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid x:Name="ImageHost" Background="{DynamicResource SubtleSurfaceBrush}" ClipToBounds="True">
                <Image x:Name="ScreenshotImage" Stretch="Uniform" AutomationProperties.Name="Step screenshot" />
                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        Cursor="Cross"
                        MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                        MouseMove="OverlayCanvas_MouseMove"
                        MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp"
                        MouseRightButtonUp="OverlayCanvas_MouseRightButtonUp" />
            </Grid>
        </Border>

        <!--  Step text  -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="12,0,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Title" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                    <TextBox AutomationProperties.Name="Step title" x:Name="TitleBox" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                             TextChanged="Text_Changed" />
                    <Button AutomationProperties.Name="Use the suggested title" x:Name="SuggestedTitleButton" Click="UseSuggestedTitle_Click"
                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3"
                            Style="{StaticResource SubtleActionButton}"
                            ToolTip="Replace the title with the one OpenSteps suggests for this step">
                        <TextBlock x:Name="SuggestedTitleText" TextTrimming="CharacterEllipsis" MaxWidth="290" FontSize="11.5" />
                    </Button>

                    <TextBlock Text="Description" Style="{StaticResource CaptionText}" Margin="0,18,0,6" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="LegacyNotice" Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="This screenshot was edited with an earlier version of OpenSteps, so its boxes and arrows can't be changed one by one. Changing the screenshot here starts again from the original capture." />
                    </Border>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0"
                               Text="Use Select to move, resize or recolour an edit, or press Delete to remove it (right-click also removes). Your edits are saved on a copy: the original capture is never changed, and Reset to original brings it back." />
                </StackPanel>

                <TextBox AutomationProperties.Name="Step description" x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         TextChanged="Text_Changed" />
            </DockPanel>
        </Border>

        <!--  Footer  -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="ToolHintText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0" IsCancel="False" />
                <Button Content="Save" Click="Save_Click" Padding="22,7" Style="{StaticResource PrimaryActionButton}"
                        ToolTip="Save (Ctrl+S)" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
