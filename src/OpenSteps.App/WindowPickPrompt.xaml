<Window x:Class="OpenSteps.App.WindowPickPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a window"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False">
    <Border Margin="10"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource InfoBrush}"
            BorderThickness="2"
            CornerRadius="12"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect Color="#1F2937" BlurRadius="22" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7C4;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="{StaticResource InfoBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Click the window you want to record"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Click its title bar to avoid pressing anything inside it."
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Focusable="False"
                    Height="32"
                    Padding="14,0"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
